rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCreator() {
      return signedIn() && request.auth.uid == resource.data.createdBy;
    }

    function hasValidInitialPlaceAggregates() {
      return !('rating' in request.resource.data)
        && !('reviewCount' in request.resource.data)
        && !('ratingSum' in request.resource.data)
        && !('aggregateUpdatedAt' in request.resource.data);
    }

    function placeAggregateFieldsAreUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ratingSum',
        'reviewCount',
        'rating',
        'aggregateUpdatedAt'
      ]);
    }

    function hasValidReviewShape(placeId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'id',
          'placeId',
          'userId',
          'rating',
          'reviewText',
          'comment',
          'imageUrls',
          'createdAt',
          'isEdited',
          'likedUserIds',
          'reportCount'
        ])
        && data.userId is string
        && data.placeId is string
        && data.placeId == placeId
        && data.rating is number
        && data.rating >= 1
        && data.rating <= 5
        && data.createdAt is timestamp
        && (!('id' in data) || data.id is string)
        && (!('reviewText' in data)
          || (data.reviewText is string && data.reviewText.size() <= 2000))
        && (!('comment' in data)
          || (data.comment is string && data.comment.size() <= 2000))
        && (!('imageUrls' in data)
          || (data.imageUrls is list && data.imageUrls.size() <= 10))
        && (!('likedUserIds' in data) || data.likedUserIds is list)
        && (!('isEdited' in data) || data.isEdited is bool)
        && (!('reportCount' in data)
          || (data.reportCount is int && data.reportCount >= 0));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isUser(userId);

      match /saved_places/{placeId} {
        allow read, create, update, delete: if isUser(userId);
      }

      match /following/{targetUserId} {
        allow read: if isUser(userId);
        allow create, update: if isUser(userId)
          && userId != targetUserId
          && request.resource.data.userId == targetUserId;
        allow delete: if isUser(userId) && userId != targetUserId;
      }

      match /followers/{followerUserId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == followerUserId
          && userId != followerUserId
          && request.resource.data.userId == followerUserId;
        allow delete: if signedIn()
          && request.auth.uid == followerUserId
          && userId != followerUserId;
      }
    }

    match /places/{placeId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && hasValidInitialPlaceAggregates();
      allow update: if isCreator()
        && request.resource.data.createdBy == resource.data.createdBy
        && placeAggregateFieldsAreUnchanged();
      allow delete: if isCreator();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && hasValidReviewShape(placeId);
        allow update: if signedIn()
          && request.auth.uid == resource.data.userId
          && hasValidReviewShape(placeId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.placeId == resource.data.placeId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if signedIn()
          && request.auth.uid == resource.data.userId;
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCreator()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isCreator();
    }

    match /hangouts/{hangoutId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCreator()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isCreator();
    }

    match /venues/{venueId} {
      allow read: if true;
    }

    match /activities/{activityId} {
      allow read: if true;
    }
  }
}
